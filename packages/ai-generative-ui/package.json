{
  "name": "@tanstack/ai-generative-ui",
  "version": "0.1.0",
  "description": "Open Generative UI specification (Draft 0.1) schemas, validator, drivers, fixtures, and React renderer for TanStack AI.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "homepage": "https://tanstack.com/ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/ai.git",
    "directory": "packages/ai-generative-ui"
  },
  "bugs": {
    "url": "https://github.com/TanStack/ai/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "type": "module",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react.d.ts",
      "import": "./dist/esm/react.js"
    },
    "./artifacts": {
      "types": "./dist/esm/artifacts.d.ts",
      "import": "./dist/esm/artifacts.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "test:oxlint": "oxlint src --type-aware",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "test:build": "publint --strict",
    "build": "vite build"
  },
  "keywords": [
    "ai",
    "tanstack",
    "generative-ui",
    "declarative-ui",
    "react",
    "agent-ui"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@tanstack/ai": "workspace:^",
    "@tanstack/ai-persistence": "workspace:^",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    },
    "@tanstack/ai-persistence": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@tanstack/ai": "workspace:*",
    "@tanstack/ai-persistence": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "premove": "^4.0.0",
    "publint": "^0.3.15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
